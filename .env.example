# ===== Monk Hagen — server environment =====
# Copy this file to ".env" and fill in real values.

# MongoDB (local). For Atlas use the SRV connection string instead.
MONGODB_URI=mongodb://localhost:27017/monkhagen

# Server
PORT=3000

# JWT
JWT_SECRET=monk-hagen-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
