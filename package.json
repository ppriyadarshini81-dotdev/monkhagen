{
  "name": "clothing-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:shipping": "node --test server/tests/*.test.js",
    "test:cloudflare": "node --test cloudflare/*.test.mjs",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "seed": "node server/seed.js",
    "db:migrate": "node server/migrate.js",
    "db:check": "node server/checkConnection.js",
    "analytics:check": "node server/checkAnalytics.js",
    "security:maintenance": "node server/maintenance.js",
    "dev": "concurrently -k -n API,NG -c blue,green \"npm:server:dev\" \"npm:start\"",
    "start:prod": "npm run build && node server/index.js"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@angular/common": "^20.3.31",
    "@angular/compiler": "^20.3.31",
    "@angular/core": "^20.3.31",
    "@angular/forms": "^20.3.31",
    "@angular/platform-browser": "^20.3.31",
    "@angular/platform-browser-dynamic": "^20.3.31",
    "@angular/router": "^20.3.31",
    "@aws-sdk/client-s3": "^3.1118.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.2",
    "file-type": "^21.3.4",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.30",
    "@angular/cli": "^20.3.30",
    "@angular/compiler-cli": "^20.3.31",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.1.2",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.9",
    "typescript": "~5.9.3",
    "wrangler": "4.134.0"
  }
}
